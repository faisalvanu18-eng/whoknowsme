# ---------------------------------------------------------------------------
# Who Knows You Better? environment variables
# Copy to .env.local for local dev. In Vercel, add them under Project > Settings > Environment Variables.
# Variables prefixed NEXT_PUBLIC_ are shipped to the browser. Everything else is server-only.
# ---------------------------------------------------------------------------

# Public canonical URL (custom domain, no trailing slash). Used for OG images, sitemap, share links.
NEXT_PUBLIC_SITE_URL=https://whoknowsyoubetter.example
NEXT_PUBLIC_SITE_NAME="Who Knows You Better?"
# Public contact address shown on /contact (a role inbox, not a personal one).
NEXT_PUBLIC_CONTACT_EMAIL=hello@whoknowsyoubetter.example

# --- Supabase (server-only) -------------------------------------------------
# Project URL and the SECRET key (Project Settings > API Keys > Secret keys, "sb_secret_...").
# The legacy service_role JWT also works via SUPABASE_SERVICE_ROLE_KEY. NEVER expose either to the browser.
# The publishable (anon) key is not used: by design anon has no access to any table.
# supabase-js talks to PostgREST over HTTP, which is pooled by Supabase, so no extra pooler config is needed.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=

# --- Upstash Redis (rate limiting) -----------------------------------------
# If unset, an in-memory limiter is used (fine for local dev, NOT for production on serverless).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudflare Turnstile (invisible bot protection on quiz creation) --------
# If unset, verification is skipped (local dev only). Use "Invisible" or "Managed" widget mode.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Admin -------------------------------------------------------------------
# Long random password for /admin (24+ chars). Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_PASSWORD=
# HMAC secret for the admin session cookie (32+ bytes). Generate the same way with 32 bytes.
ADMIN_SESSION_SECRET=

# --- Analytics -----------------------------------------------------------------
# GA4 measurement ID (G-XXXXXXX). Leave empty to disable GA.
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification token (content="..." value only). Optional.
GOOGLE_SITE_VERIFICATION=

# --- AdSense -------------------------------------------------------------------
# Keep "false" until AdSense has approved the site. Ad slots render nothing while false.
NEXT_PUBLIC_ADS_ENABLED=false
# Your publisher client ID, e.g. ca-pub-1234567890123456 (also used to generate /ads.txt).
NEXT_PUBLIC_ADSENSE_CLIENT=
# Ad unit slot IDs (create "Display" units in AdSense; one per placement makes A/B tests readable).
NEXT_PUBLIC_AD_SLOT_HOME=
NEXT_PUBLIC_AD_SLOT_ARTICLE=
NEXT_PUBLIC_AD_SLOT_RESULT=
NEXT_PUBLIC_AD_SLOT_CONTENT=
# "true" loads Google's own certified CMP (AdSense > Privacy & messaging) for EEA/UK/CH visitors.
# Configure the GDPR message in AdSense first. When false, the built-in banner + Consent Mode v2 is used.
NEXT_PUBLIC_GOOGLE_CMP_ENABLED=false
